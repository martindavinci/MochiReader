{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MochiReader",
  "version": "0.1.0",
  "identifier": "io.github.martindavinci.mochireader",
  "build": { "frontendDist": "../app" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "MochiReader",
        "width": 900,
        "height": 700,
        "visible": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,CalculateNativeWinOcclusion --autoplay-policy=no-user-gesture-required --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows --no-proxy-server --disable-background-networking --disable-component-update"
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline' blob:; img-src 'self' data: blob: http://mochi.localhost; font-src 'self' data: blob:; media-src blob:; frame-src blob:; connect-src ipc: http://ipc.localhost http://mochi.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": { "../app/licenses.txt": "licenses.txt" }
  }
}
